---
const { post } = Astro.props;
const date = post.data.date.toLocaleDateString('ja-JP');
const base = import.meta.env.BASE_URL;
---

<article class="post-item">
  <div class="meta">
    <time datetime={post.data.date.toISOString()}>{date}</time>
    <a href={`${base}categories/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a>
  </div>
  <h2><a href={`${base}posts/${post.slug}/`}>{post.data.title}</a></h2>
  {post.data.summary ? <p>{post.data.summary}</p> : null}
  {post.data.tags?.length ? (
    <div class="tag-list">
      {post.data.tags.map((tag) => (
        <a class="tag" href={`${base}tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
      ))}
    </div>
  ) : null}
</article>
