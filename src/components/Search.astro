---
const base = import.meta.env.BASE_URL;
---

<section class="search" data-base={base}>
  <input id="searchInput" type="search" placeholder="記事を検索" aria-label="記事を検索" />
  <div id="searchResults" class="search-results post-list" hidden></div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.search');
  const base = root?.dataset.base ?? '/';
  const input = document.getElementById('searchInput') as HTMLInputElement | null;
  const results = document.getElementById('searchResults') as HTMLElement | null;
  const list = document.querySelector<HTMLElement>('.post-list:not(.search-results)');

  type Item = {
    slug: string;
    title: string;
    date: string;
    category: string;
    tags: string[];
    summary: string;
    body: string;
  };

  let index: Item[] = [];

  const escape = (value: string) =>
    value.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  const normalize = (value: string) =>
    value
      .toLowerCase()
      .replace(/[^\p{L}\p{N}]+/gu, ' ')
      .trim();

  const render = (items: Item[], query: string) => {
    if (!results) return;
    const active = Boolean(query);
    results.hidden = !active;
    if (list) list.hidden = active;
    if (!active) {
      results.innerHTML = '';
      return;
    }

    if (!items.length) {
      results.innerHTML = '<p class="search-empty">見つかりませんでした</p>';
      return;
    }

    results.innerHTML = items
      .map((item) => {
        const tags = item.tags?.length
          ? `<div class="tag-list">${item.tags
              .map((tag) => `<span class="tag">#${escape(tag)}</span>`)
              .join('')}</div>`
          : '';
        return `
          <article class="post-item">
            <div class="meta">
              <span>${escape(item.date)}</span>
              <span>${escape(item.category)}</span>
            </div>
            <h2><a href="${base}posts/${item.slug}/">${escape(item.title)}</a></h2>
            ${item.summary ? `<p>${escape(item.summary)}</p>` : ''}
            ${tags}
          </article>
        `;
      })
      .join('');
  };

  const search = (query: string) => {
    const q = normalize(query);
    if (!q) return [];
    return index.filter((item) =>
      normalize(`${item.title} ${item.summary} ${item.tags.join(' ')} ${item.body}`).includes(q),
    );
  };

  fetch(`${base}search-index.json`)
    .then((res) => res.json())
    .then((data) => {
      index = data;
      if (input?.value) render(search(input.value).slice(0, 20), input.value.trim());
    })
    .catch(() => {
      if (input) input.placeholder = '検索を読み込めませんでした';
    });

  input?.addEventListener('input', () => {
    const query = input.value;
    render(search(query).slice(0, 20), query.trim());
  });
</script>
