---
import 'katex/dist/katex.min.css';
import '../styles/global.css';

const { title, description, wide = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161717" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <header class="site-header">
      <div class:list={["site-header-inner", { "page-wide": wide }]}>
        <nav class="nav">
          <a href={base}>記事</a>
          <a href={`${base}tags/`}>タグ</a>
        </nav>
      </div>
    </header>

    <main class:list={["page", { "page-wide": wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class:list={["site-footer-inner", { "page-wide": wide }]}>
        <a href={`${base}categories/`}>カテゴリ</a>
      </div>
    </footer>
  </body>
</html>
